<Window x:Class="HeliumVideoTools.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:HeliumVideoTools.Desktop"
 Title="Helium Vídeo Tools" Width="1120" Height="760" MinWidth="675" MinHeight="329"
 Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource AppBackground}" FontFamily="Segoe UI" FontSize="14" AllowDrop="True" KeyboardNavigation.TabNavigation="Continue" Icon="Assets/logo.ico"
 Closing="WindowClosing">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="MinHeight" Value="26"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid Background="{DynamicResource AppBackground}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0" Padding="12,20,12,12">
   <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,0">
     <TextBlock Text="APARÊNCIA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
     <ComboBox x:Name="ThemeChoice" KeyboardNavigation.TabIndex="3" SelectionChanged="ThemeChanged" Margin="0,0,0,12" AutomationProperties.Name="Aparência do aplicativo" AutomationProperties.HelpText="Sistema segue o Windows; alto contraste do Windows tem prioridade."/>
     <TextBlock x:Name="ThemeHelp" Text="Tab navega · Espaço alterna" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"/>
     <Button x:Name="UpdatesButton" KeyboardNavigation.TabIndex="4" Style="{StaticResource NavigationButton}" Click="ShowUpdates" Margin="-8,0,-8,14" AutomationProperties.Name="Atualizações do aplicativo e ferramentas"><StackPanel Orientation="Horizontal"><local:Symbol Kind="preset" Foreground="{DynamicResource Icon}" Margin="0,0,10,0"/><TextBlock x:Name="UpdatesLabel" Text="Atualizações" VerticalAlignment="Center" FontSize="13"/></StackPanel></Button>
     <Border Background="{DynamicResource SuccessBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><local:Symbol Kind="shield" Foreground="{DynamicResource SuccessText}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Originais preservados" FontSize="11" Foreground="{DynamicResource SuccessText}"/></StackPanel></Border><TextBlock x:Name="ProductVersion" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
    </StackPanel>
    <StackPanel>
     <Image Source="{DynamicResource BrandSignature}" Width="162" Height="49" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,24" AutomationProperties.Name="Helium Vídeo Tools"/>
     <TextBlock Text="FERRAMENTAS" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,12"/>
     <Button x:Name="SplitNav" KeyboardNavigation.TabIndex="0" Style="{StaticResource NavigationButton}" Click="Navigate" Tag="Split" AutomationProperties.Name="Dividir vídeos"><StackPanel Orientation="Horizontal"><local:Symbol Kind="split" Foreground="{DynamicResource Icon}" Margin="0,0,12,0"/><TextBlock Text="Dividir" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="CompressNav" KeyboardNavigation.TabIndex="1" Style="{StaticResource NavigationButton}" Click="Navigate" Tag="Compress" Foreground="{DynamicResource SelectedText}" Background="{DynamicResource SelectedBackground}" BorderBrush="{DynamicResource Icon}" AutomationProperties.Name="Compactar vídeos"><StackPanel Orientation="Horizontal"><local:Symbol Kind="compress" Foreground="{DynamicResource SelectedIcon}" Margin="0,0,12,0"/><TextBlock Text="Compactar" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="WebmNav" KeyboardNavigation.TabIndex="2" Style="{StaticResource NavigationButton}" Click="Navigate" Tag="Webm" AutomationProperties.Name="Converter vídeos"><StackPanel Orientation="Horizontal"><local:Symbol Kind="convert" Foreground="{DynamicResource Icon}" Margin="0,0,12,0"/><TextBlock Text="Converter" VerticalAlignment="Center"/></StackPanel></Button>
     <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="12,12,12,0" Padding="0,12,0,0"><TextBlock Text="Preparação de mídias para audiências" Foreground="{DynamicResource TextSecondary}" FontSize="12"/></Border>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="20,18,20,10">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <StackPanel>
     <DockPanel Margin="0,0,0,6"><Border DockPanel.Dock="Right" Background="{DynamicResource InfoBackground}" CornerRadius="6" Padding="10,5" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock x:Name="DestinationLabel" Text="PROJUDI • MP4" Foreground="{DynamicResource InfoText}" FontWeight="SemiBold" FontSize="10"/></Border><TextBlock x:Name="Heading" Text="Compactar vídeos" FontSize="25" FontWeight="SemiBold"/></DockPanel>
     <TextBlock x:Name="Subtitle" Text="Reduza o tamanho para envio ao Projudi. O arquivo final é conferido antes de salvar." Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" FontSize="12"/>
     <Grid x:Name="WorkPanels"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="FilesCard" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,0"><Grid x:Name="FilesPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12"><TextBlock x:Name="FileCount" DockPanel.Dock="Right" Text="Nenhum arquivo" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><local:Symbol Kind="video" Foreground="{DynamicResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Vídeos de entrada" FontWeight="SemiBold" FontSize="16"/></StackPanel></DockPanel>
      <Grid Grid.Row="1" MinHeight="142" Margin="0,0,0,12">
       <ListBox x:Name="FilesList" ItemsSource="{Binding Files}" SelectionMode="Extended" Background="{DynamicResource DropBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Arquivos selecionados">
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:Symbol Kind="video" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Grid></DataTemplate></ListBox.ItemTemplate>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="Padding" Value="8,6"/><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowFace" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowFace" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowFace" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="RowFace" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
       </ListBox>
       <StackPanel x:Name="DropHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:Symbol Kind="upload" Foreground="{DynamicResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Solte seus vídeos aqui" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/></StackPanel><TextBlock Text="ou em qualquer lugar da janela" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
      <UniformGrid x:Name="FileButtons" Grid.Row="2" Columns="3" Margin="-4,0,-4,0">
       <Button Click="Browse" AutomationProperties.Name="Adicionar vídeos" ToolTip="Adicionar vídeos" Margin="4,0" Padding="4,7" MinHeight="36"><StackPanel Orientation="Horizontal"><local:Symbol Kind="add" Width="14" Height="14" Foreground="{DynamicResource Icon}" Margin="0,0,4,0"/><TextBlock Text="Adicionar" VerticalAlignment="Center"/></StackPanel></Button>
       <Button Click="Remove" AutomationProperties.Name="Remover arquivos selecionados" ToolTip="Remover arquivos selecionados" Margin="4,0" Padding="4,7" MinHeight="36"><StackPanel Orientation="Horizontal"><local:Symbol Kind="remove" Width="14" Height="14" Margin="0,0,4,0"/><TextBlock Text="Remover" VerticalAlignment="Center"/></StackPanel></Button>
       <Button Click="Clear" AutomationProperties.Name="Limpar seleção de vídeos" Margin="4,0" Padding="4,7" MinHeight="36"><StackPanel Orientation="Horizontal"><local:Symbol Kind="clear" Width="14" Height="14" Margin="0,0,4,0"/><TextBlock Text="Limpar" VerticalAlignment="Center"/></StackPanel></Button>
      </UniformGrid>
     </Grid></Border>
     <Border x:Name="OutputCard" Grid.Column="1" Style="{StaticResource Card}" Padding="14" Margin="0"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><local:Symbol Kind="preset" Foreground="{DynamicResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Configurações de saída" FontSize="14" FontWeight="SemiBold"/></StackPanel><StackPanel x:Name="OptionsPanel"/></StackPanel></Border>
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <Border x:Name="ActionBar" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,4,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><local:Symbol Kind="folder" Foreground="{DynamicResource TextSecondary}" Width="19" Height="19" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Ao lado dos originais" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Novos arquivos, sem substituir a audiência." Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/></StackPanel></StackPanel>
     <Button Grid.Column="1" x:Name="RunButton" Style="{StaticResource PrimaryButton}" MinWidth="140" MinHeight="38" Padding="14,8" Click="Run" AutomationProperties.Name="Compactar vídeos agora"><StackPanel Orientation="Horizontal"><local:Symbol x:Name="RunIcon" Kind="compress" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock x:Name="RunLabel" Text="Compactar" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><local:Symbol Kind="arrow" Width="18" Height="18" Margin="16,0,0,0"/></StackPanel></Button>
    </Grid>
   </Border>
   <Border Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Style="{StaticResource Card}" BorderBrush="{DynamicResource Focus}" Padding="12" Margin="0,10,4,0"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ResetButton" Click="ResetSession" Visibility="Collapsed" Margin="0,0,8,0" AutomationProperties.Name="Voltar ao início e limpar a sessão"><StackPanel Orientation="Horizontal"><local:Symbol Kind="home" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Voltar ao início"/></StackPanel></Button><Button x:Name="ReportButton" Content="Ver relatório" Visibility="Collapsed" Click="OpenReport" Margin="0,0,8,0"/><Button x:Name="ProgressAction" Content="Cancelar tudo" Click="ProgressActionClicked"/></StackPanel><StackPanel Orientation="Horizontal"><local:Symbol x:Name="ProgressIcon" Kind="estimate" Foreground="{DynamicResource Icon}" Margin="0,0,8,0"/><TextBlock x:Name="ProgressHeading" Text="Progresso geral" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel><TextBlock x:Name="ProgressStatus" Margin="0,10,0,10" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="ResultDetails" Visibility="Collapsed" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10"/><ProgressBar x:Name="OverallBar" AutomationProperties.Name="Progresso geral do processamento" Height="8" Minimum="0" Maximum="100" Foreground="{DynamicResource Focus}"/></StackPanel></Border>
   <TextBlock Grid.Row="3" x:Name="Status" Text="Pronto" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="2,10,0,0"/>
  </Grid>
 </Grid>
</Window>
