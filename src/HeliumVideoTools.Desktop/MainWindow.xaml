<Window x:Class="HeliumVideoTools.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:HeliumVideoTools.Desktop"
 Title="Helium Vídeo Tools" Width="1280" Height="900" MinWidth="980" MinHeight="700"
 Background="#202020" FontFamily="Segoe UI" FontSize="14" AllowDrop="True" Icon="Assets/logo.ico"
 Drop="FilesDropped" DragOver="FilesDragOver" Closing="WindowClosing">
 <Grid Background="#202020">
  <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#252525" BorderBrush="#393939" BorderThickness="0,0,1,0" Padding="16,24,16,16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,0">
     <Button x:Name="UpdatesButton" Style="{StaticResource NavigationButton}" Click="ShowUpdates" Margin="-8,0,-8,14" AutomationProperties.Name="Atualizações do aplicativo e ferramentas"><StackPanel Orientation="Horizontal"><local:Symbol Kind="preset" Foreground="#6CCCF0" Margin="0,0,10,0"/><TextBlock x:Name="UpdatesLabel" Text="Atualizações" VerticalAlignment="Center" FontSize="13"/></StackPanel></Button>
     <Border Background="#28352F" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><local:Symbol Kind="shield" Foreground="#8AD7AE" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Originais preservados" FontSize="11" Foreground="#A5DDBB"/></StackPanel></Border><TextBlock x:Name="ProductVersion" Foreground="#AAAAAA" FontSize="11"/>
    </StackPanel>
    <StackPanel>
     <Image Source="Assets/brand-signature.png" Width="200" Height="60" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,30" AutomationProperties.Name="Helium Vídeo Tools"/>
     <TextBlock Text="FERRAMENTAS" Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,12"/>
     <Button x:Name="SplitNav" Style="{StaticResource NavigationButton}" Click="Navigate" Tag="Split" AutomationProperties.Name="Dividir vídeos"><StackPanel Orientation="Horizontal"><local:Symbol Kind="split" Foreground="#6CCCF0" Margin="0,0,12,0"/><TextBlock Text="Dividir" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="CompressNav" Style="{StaticResource NavigationButton}" Click="Navigate" Tag="Compress" Background="#353D44" BorderBrush="#6CCCF0" AutomationProperties.Name="Compactar vídeos"><StackPanel Orientation="Horizontal"><local:Symbol Kind="compress" Foreground="#6CCCF0" Margin="0,0,12,0"/><TextBlock Text="Compactar" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="WebmNav" Style="{StaticResource NavigationButton}" Click="Navigate" Tag="Webm" AutomationProperties.Name="Converter vídeos"><StackPanel Orientation="Horizontal"><local:Symbol Kind="convert" Foreground="#6CCCF0" Margin="0,0,12,0"/><TextBlock Text="Converter" VerticalAlignment="Center"/></StackPanel></Button>
     <Border BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Margin="12,22,12,0" Padding="0,18,0,0"><TextBlock Text="Preparação de mídias para audiências" Foreground="#AAAAAA" FontSize="12"/></Border>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,12">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <StackPanel>
     <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Background="#26394A" CornerRadius="6" Padding="10,5" VerticalAlignment="Center"><TextBlock x:Name="DestinationLabel" Text="PROJUDI • MP4" Foreground="#9CD9F6" FontWeight="SemiBold" FontSize="10"/></Border><TextBlock Text="ESPAÇO DE TRABALHO" Foreground="#ADADAD" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <TextBlock x:Name="Heading" Text="Compactar vídeos" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <TextBlock x:Name="Subtitle" Text="Reduza o tamanho para envio ao Projudi. O arquivo final é conferido antes de salvar." Foreground="#BDBDBD" Margin="0,0,0,20" FontSize="13"/>
     <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14"><StackPanel>
      <DockPanel Margin="0,0,0,12"><TextBlock x:Name="FileCount" DockPanel.Dock="Right" Text="Nenhum arquivo" Foreground="#ADADAD" FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><local:Symbol Kind="video" Foreground="#6CCCF0" Margin="0,0,10,0"/><TextBlock Text="Vídeos de entrada" FontWeight="SemiBold" FontSize="16"/></StackPanel></DockPanel>
      <Grid Height="92" Margin="0,0,0,12">
       <ListBox x:Name="FilesList" ItemsSource="{Binding Files}" SelectionMode="Extended" Background="#232323" Foreground="#F3F3F3" BorderBrush="#494949" Padding="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Arquivos selecionados">
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:Symbol Kind="video" Foreground="#85CAE7" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Grid></DataTemplate></ListBox.ItemTemplate>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6"/><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
       </ListBox>
       <StackPanel x:Name="DropHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:Symbol Kind="upload" Foreground="#84C9E8" Margin="0,0,10,0"/><TextBlock Text="Solte seus vídeos aqui" Foreground="#DADADA" FontWeight="SemiBold"/></StackPanel><TextBlock Text="MP4, MKV, MOV, AVI, M4V e WebM" FontSize="11" Foreground="#AAAAAA" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal"><Button Click="Browse" Padding="12,7"><StackPanel Orientation="Horizontal"><local:Symbol Kind="add" Width="17" Height="17" Foreground="#6CCCF0" Margin="0,0,6,0"/><TextBlock Text="Adicionar vídeos"/></StackPanel></Button><Button Click="Remove" Margin="8,0" Padding="10,7" ToolTip="Remover os arquivos selecionados"><StackPanel Orientation="Horizontal"><local:Symbol Kind="remove" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Remover"/></StackPanel></Button><Button Click="Clear" Padding="10,7"><StackPanel Orientation="Horizontal"><local:Symbol Kind="clear" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Limpar"/></StackPanel></Button></StackPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,14"><local:Symbol Kind="preset" Foreground="#6CCCF0" Margin="0,0,10,0"/><TextBlock Text="Configurações de saída" FontSize="16" FontWeight="SemiBold"/></StackPanel><StackPanel x:Name="OptionsPanel"/></StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <Border x:Name="ActionBar" Grid.Row="1" Background="#292929" BorderBrush="#454545" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,10,4,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><local:Symbol Kind="folder" Foreground="#ADADAD" Width="19" Height="19" Margin="0,0,10,0"/><StackPanel><TextBlock Text="Ao lado dos originais" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Novos arquivos, sem substituir a audiência." Foreground="#ADADAD" FontSize="11" Margin="0,3,0,0"/></StackPanel></StackPanel>
     <Button Grid.Column="1" x:Name="RunButton" Style="{StaticResource PrimaryButton}" Click="Run" AutomationProperties.Name="Compactar vídeos agora"><StackPanel Orientation="Horizontal"><local:Symbol x:Name="RunIcon" Kind="compress" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock x:Name="RunLabel" Text="Compactar" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><local:Symbol Kind="arrow" Width="18" Height="18" Margin="16,0,0,0"/></StackPanel></Button>
    </Grid>
   </Border>
   <Border Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Style="{StaticResource Card}" BorderBrush="#57CCF2" Padding="16" Margin="0,10,4,0"><StackPanel><DockPanel><Button x:Name="ProgressAction" DockPanel.Dock="Right" Content="Cancelar tudo" Click="ProgressActionClicked"/><StackPanel Orientation="Horizontal"><local:Symbol Kind="estimate" Foreground="#6CCCF0" Margin="0,0,8,0"/><TextBlock Text="Progresso geral" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel><TextBlock x:Name="ProgressStatus" Margin="0,10,0,10"/><ProgressBar x:Name="OverallBar" Height="8" Minimum="0" Maximum="100" Foreground="#57CCF2"/></StackPanel></Border>
   <TextBlock Grid.Row="3" x:Name="Status" Text="Pronto" Foreground="#ADADAD" FontSize="11" Margin="2,10,0,0"/>
  </Grid>
 </Grid>
</Window>
