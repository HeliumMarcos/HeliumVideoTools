<Window x:Class="HeliumVideoTools.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Helium Vídeo Tools" Width="1280" Height="900" MinWidth="980" MinHeight="700" Background="#202020" FontFamily="Segoe UI" FontSize="14" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragOver" Closing="WindowClosing">
 <Grid Background="#202020">
  <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#292929" BorderBrush="#454545" BorderThickness="0,0,1,0" Padding="16">
   <DockPanel LastChildFill="True">
    <TextBlock DockPanel.Dock="Bottom" Text="3.0.0 • Prévia .NET" Foreground="#BDBDBD" Margin="8"/>
    <StackPanel>
     <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,28"><StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/logo.png" Width="48" Height="48" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="HELIUM" FontWeight="Bold" FontSize="21"/><TextBlock Text="VÍDEO TOOLS" Foreground="#57CCF2" FontSize="12"/></StackPanel></StackPanel><TextBlock Text="Mídias de audiências" Foreground="#C0C0C0" Margin="0,12,0,0"/></StackPanel></Border>
     <Button x:Name="SplitNav" Content="Dividir" Click="Navigate" Tag="Split" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
     <Button x:Name="CompressNav" Content="Compactar" Click="Navigate" Tag="Compress" Background="#3B3B3B" Margin="0,0,0,10"/>
     <Button x:Name="WebmNav" Content="Converter" Click="Navigate" Tag="Webm" Margin="0,0,0,10"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24,24,24,16">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,16">
     <TextBlock Text="FERRAMENTAS DE VÍDEO" Foreground="#57CCF2" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
     <TextBlock x:Name="Heading" Text="Compactar vídeos" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock x:Name="Subtitle" Text="Prepare vídeos de audiências para o Projudi, com tamanho final verificado." Foreground="#C0C0C0" Margin="0,0,0,20"/>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Vídeos de entrada" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,8"/>
      <TextBlock Text="Arraste os arquivos ou selecione pelo Explorador. Os originais serão preservados." Foreground="#C0C0C0" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button Content="Adicionar vídeos" Click="Browse"/><Button Content="Remover" Click="Remove" Margin="8,0"/><Button Content="Limpar" Click="Clear"/></StackPanel>
      <Grid MinHeight="120"><ListBox x:Name="FilesList" ItemsSource="{Binding Files}" DisplayMemberPath="Name" SelectionMode="Extended" Background="#242424" Foreground="#F3F3F3" BorderBrush="#454545" Height="140" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Arquivos selecionados"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="ToolTip" Value="{Binding Path}"/></Style></ListBox.ItemContainerStyle></ListBox><TextBlock x:Name="DropHint" Text="Solte seus vídeos aqui" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C0C0C0"/></Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel x:Name="OptionsPanel"/></Border>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Resultados salvos ao lado dos arquivos originais." Foreground="#C0C0C0" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Grid.Column="1" x:Name="RunButton" Content="Compactar" Background="#0067C0" Click="Run" MinWidth="130"/></Grid>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="1" x:Name="ProgressPanel" Visibility="Collapsed" Style="{StaticResource Card}" BorderBrush="#57CCF2" Padding="16" Margin="0,12,0,12"><StackPanel><DockPanel><Button x:Name="ProgressAction" DockPanel.Dock="Right" Content="Cancelar tudo" Click="ProgressActionClicked"/><TextBlock Text="Progresso geral" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="ProgressStatus" Margin="0,10,0,10"/><ProgressBar x:Name="OverallBar" Height="10" Minimum="0" Maximum="100" Foreground="#57CCF2"/></StackPanel></Border>
   <TextBlock Grid.Row="2" x:Name="Status" Text="Pronto" Foreground="#BDBDBD"/>
  </Grid>
 </Grid>
</Window>
